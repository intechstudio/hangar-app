# Response headers for hangar.intech.studio.
#
# Copied into upstream/build/_headers by .github/workflows/deploy.yml, because
# the build directory comes from upstream and we do not modify upstream source.
# Cloudflare reads this file from the assets directory and does not serve it.
#
# Syntax: a path pattern, then each header indented beneath it. Up to 100 rules.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Note this works only because we deploy no Worker code — these headers are not
# applied to responses generated by a Worker.

# Internal development pages. They are not linked from the site, but they are
# publicly reachable, and robots.txt allows crawling everything: upstream relied
# on the preproduction Basic Auth worker's X-Robots-Tag to keep them out of
# search results, and that worker is not deployed here.
#
# noindex is set as a header rather than a robots.txt Disallow on purpose. A
# Disallow stops crawlers reading the page at all, so they never see the noindex
# and the URL can still be indexed from an external link.
/dev/*
  X-Robots-Tag: noindex, nofollow
